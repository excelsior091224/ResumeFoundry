---
import BaseLayout from '../../layouts/BaseLayout.astro';
import skillCategories from '../../data/skills.json';
import teamRoles from '../../data/team-roles.json';
import { createBlankResume } from '../../features/resume/defaults';
import { renderResumePreviewHtml } from '../../features/resume/render';

const initialResume = createBlankResume();
const bootstrap = {
  initialResume,
  skillCategories,
  teamRoles,
  endpoints: {
    summary: '/api/resume/summary',
    preview: '/api/resume/preview',
    downloadPdf: '/api/resume/download/pdf',
    downloadDocx: '/api/resume/download/docx',
  },
};
---

<BaseLayout
  title="職務経歴書ジェネレーター | Resume Foundry"
  description="Cloudflare Workers上で動く登録不要の職務経歴書ジェネレーター。プレビュー、AI要約、PDF/DOCX出力に対応。"
>
  <div class="resume-shell">
    <section class="resume-topbar-wrap">
      <div class="topbar topbar-local">
        <div class="brand"><span class="brand-mark">R</span><span>Resume Foundry</span></div>
        <small>入力内容は保存されません（下書きはこのブラウザのローカル保存のみ）</small>
      </div>
    </section>

    <section class="workspace workspace-resume">
      <section class="form-panel">
        <div class="intro">
          <span class="eyebrow">Career document builder</span>
          <h1>職務経歴書をつくる</h1>
          <p>Laravel版の一括生成機能をCloudflare Workers向けに移植した、登録不要のワンショット作成画面です。</p>
        </div>
        <div id="resume-form-root"></div>
        <noscript>
          <p class="validation-summary">このページは動的な行追加・プレビュー更新のため JavaScript が必要です。</p>
        </noscript>
      </section>

      <section class="preview-panel">
        <div class="preview-label">
          <span>Live preview</span>
          <span id="resume-preview-stats">1 companies · 1 projects · 1 skills</span>
        </div>
        <div class="paper-wrap">
          <div id="resume-preview" class="paper" set:html={renderResumePreviewHtml(initialResume)}></div>
        </div>
      </section>
    </section>
  </div>

  <script is:inline id="resume-bootstrap" type="application/json" set:html={JSON.stringify(bootstrap)}></script>
  <script>
    import { initResumeForm } from '../../scripts/resume-form';

    initResumeForm();
  </script>
</BaseLayout>
