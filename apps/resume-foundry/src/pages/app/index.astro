---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { env } from 'cloudflare:workers';
import { AccountDeletedError, ensureClerkUserExists, getCareerStats } from '../../features/careers/db';

const auth = Astro.locals.auth();
if (!auth.isAuthenticated) {
  return auth.redirectToSignIn({ returnBackUrl: Astro.url.href });
}
const { userId } = auth;

const db = env.DB;
const clerkUser = await Astro.locals.currentUser();
const email = clerkUser?.primaryEmailAddress?.emailAddress;
const displayName = clerkUser?.fullName || clerkUser?.firstName || '';
if (db) {
  try {
    await ensureClerkUserExists(db, userId, email, displayName);
  } catch (error) {
    if (error instanceof AccountDeletedError) {
      return Astro.redirect('/?account_deleted=1', 303);
    }
    throw error;
  }
}
const stats = db
  ? await getCareerStats(db, userId)
  : { companyCount: 0, projectCount: 0, skillCount: 0, certificationCount: 0, linkCount: 0 };
---
<BaseLayout title="ダッシュボード | Resume Foundry">
  <section class="container stack">
    <div class="card">
      <span class="eyebrow">Career Dashboard (Cloudflare D1)</span>
      <h1>キャリアダッシュボード</h1>
      <p>{displayName || email || 'ユーザー'}さんの職歴・案件・スキル・資格の最新ステータスです。</p>
      <div class="kpis">
        <div class="kpi"><strong>{stats.companyCount}</strong><span>所属企業</span></div>
        <div class="kpi"><strong>{stats.projectCount}</strong><span>登録案件</span></div>
        <div class="kpi"><strong>{stats.skillCount}</strong><span>登録スキル</span></div>
        <div class="kpi"><strong>{stats.certificationCount}</strong><span>保有資格</span></div>
        <div class="kpi"><strong>{stats.linkCount}</strong><span>関連リンク</span></div>
      </div>
      <div class="actions">
        <a class="button" href="/app/careers">職歴を編集・保存する</a>
        <a class="button secondary" href="/app/preview">職務経歴書をプレビュー/出力</a>
      </div>
    </div>
  </section>
</BaseLayout>
