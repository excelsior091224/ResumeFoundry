{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "astro-resume-foundry",
  "compatibility_date": "2026-09-05",
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS"
  },
  "routes": [
    {
      "pattern": "resumefoundries.com",
      "zone_name": "resumefoundries.com",
      "custom_domain": true,
      "enabled": true,
      "previews_enabled": false
    },
    {
      "pattern": "www.resumefoundries.com",
      "zone_name": "resumefoundries.com",
      "custom_domain": true,
      "enabled": true,
      "previews_enabled": false
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "astro-resume-foundry",
      "database_id": "fdf8890f-f3ea-457b-9b1d-3822813e5581",
      "migrations_dir": "db/migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "EXPORTS",
      "bucket_name": "astro-resume-foundry-exports"
    }
  ],
  "ai": {
    "binding": "AI"
  },
  "vars": {
    "APP_ENV": "production",
    "AUTH_STRATEGY": "clerk",
    "GEMINI_MODEL": "gemini-3.5-flash-lite"
  }
}
